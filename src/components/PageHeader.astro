---
interface Props { title: string; subtitle?: string; }
const { title, subtitle } = Astro.props;
---
<section style="background:linear-gradient(180deg, var(--night-900), var(--night-800)); border-bottom:1px solid var(--border-subtle);">
  <div class="container-ka text-start" style="padding-block:clamp(40px,6vw,64px)">
    <nav class="breadcrumb-ka" style="color:var(--text-muted)">الرئيسية › {title}</nav>
    <h1 class="font-display mt-2" style="font-size:clamp(34px,6vw,54px); color:var(--parch-50); margin:0">{title}</h1>
    {subtitle && <p class="text-secondary-ka mt-2" style="max-width:640px; font-size:18px; line-height:1.7">{subtitle}</p>}
  </div>
</section>
