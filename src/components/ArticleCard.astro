---
import type { ArticleView } from '../lib/articles';
interface Props { a: ArticleView }
const { a } = Astro.props;
const dots = Array.from({ length: 5 }, (_, i) => i < a.level);
const imgStyle = a.cover
  ? `background-image:url(${a.cover});background-size:cover;background-position:center`
  : `background:linear-gradient(135deg, color-mix(in srgb, ${a.color} 55%, var(--night-700)), var(--night-900))`;
---
<a href={`/article/${a.slug}`} class="article-card-link" style="text-decoration:none;color:inherit;display:block;height:100%">
  <article class="article-card" style={`--door:${a.color}`}>
    <div class="article-card__img" style={imgStyle}>
      <span class="badge-cat position-absolute" style={`top:16px; inset-inline-end:16px; background:${a.color}`}>{a.cat}</span>
    </div>
    <div class="p-3 text-start d-flex flex-column h-100" style="gap:12px">
      <h3 class="article-card__title">{a.title}</h3>
      <p class="text-secondary-ka" style="font-size:15px;line-height:1.7;margin:0">{a.dek}</p>
      <div class="mini-meter mt-auto">
        {dots.map((on) => <i class={on ? 'on' : ''}></i>)}
      </div>
      <div class="d-flex justify-content-between align-items-center text-muted-ka" style="font-size:13px">
        <span>{a.readingTime}</span>
        <span>{a.date}</span>
      </div>
    </div>
  </article>
</a>
