---
import { TELEGRAM_URL } from '../data/site';
---
<section class="container-ka" style="padding-bottom:clamp(48px,7vw,88px)">
  <div class="tg-banner p-4 p-md-5 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 position-relative" data-reveal>
    <div class="text-center text-md-start">
      <h2 style="font-size:clamp(24px,3vw,30px)">انضم لقناة خزعبلات</h2>
      <p class="text-secondary-ka mb-0">كل خزعبلة جديدة توصلك أول بأول — وقُل لنا وش تبي نكتب عنه.</p>
    </div>
    <a href={TELEGRAM_URL} target="_blank" rel="noopener" data-tg-link class="btn btn-tg rounded-3 px-4 py-3 d-inline-flex align-items-center gap-2 flex-shrink-0" style="box-shadow:0 0 28px rgba(42,171,238,.4)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M22 3 L2 11 L9 13 L11 20 L14 16 L18 19 Z"/></svg>
      افتح القناة
    </a>
  </div>
</section>
