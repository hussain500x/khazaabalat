---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { CAT } from '../data/site';
import { getPublishedArticles, type ArticleView } from '../lib/articles';

const all = await getPublishedArticles();

// تجميع حسب الشهر: مفتاح المجموعة = التاريخ بعد إزالة اليوم ("12 أغسطس 2026" → "أغسطس 2026")
// Map يحافظ على ترتيب الإدراج، والمقالات تصل بترتيب الأحدث أولًا، فتبقى المجموعات والعناصر مرتّبة.
const groups = new Map<string, ArticleView[]>();
for (const art of all) {
  const key = art.date.trim().split(/\s+/).slice(1).join(' ') || 'غير مؤرّخة';
  const bucket = groups.get(key);
  if (bucket) bucket.push(art);
  else groups.set(key, [art]);
}
const months = [...groups.entries()];

const filters = [
  { t: 'الكل', h: '/articles', active: true },
  { t: CAT.myths.short, h: '/category/myths', color: CAT.myths.color },
  { t: CAT.legends.short, h: '/category/legends', color: CAT.legends.color },
  { t: CAT.satire.short, h: '/category/satire', color: CAT.satire.color },
  { t: CAT.world.short, h: '/category/world', color: CAT.world.color },
];
---
<Base title="الأرشيف — كل الخزعبلات | خزعبلات" description="أرشيف كل الخزعبلات مرتّبًا زمنيًا — تصفّح الخرافات والأساطير والسخرية وغرائب العالم، أو فلتر حسب الباب.">
  <Header />
  <PageHeader title="كل الخزعبلات" subtitle="أرشيف كامل مرتّب زمنياً — تصفّح أو فلتر حسب الباب." />

  <section class="section container-ka">
    <div class="row g-4">
      <!-- القائمة (يمين) -->
      <div class="col-lg-8">
        {months.length === 0 ? (
          <div class="p-4 text-start" style="background:var(--night-700);border:1px solid var(--border-subtle);border-radius:var(--radius-md)">
            <div style="font-family:var(--font-heading);font-weight:700;font-size:18px;color:var(--parch-50)">لا توجد خزعبلات بعد</div>
            <p class="text-muted-ka mb-0 mt-2" style="font-size:15px">لسّه ما نشرنا شي هنا. عُد قريباً — الأرشيف يمتلئ أول بأول.</p>
          </div>
        ) : (
          months.map(([m, items]) => (
            <div class="mb-4" data-reveal>
              <h2 class="text-start" style="font-size:20px;color:var(--lantern-500);font-family:var(--font-heading)">{m}</h2>
              <div class="d-flex flex-column gap-2 mt-3">
                {items.map((art) => (
                  <a href={`/article/${art.slug}`} class="d-flex justify-content-between align-items-center gap-3 p-3 text-start" style="background:var(--night-700);border:1px solid var(--border-subtle);border-radius:10px">
                    <span class="d-flex align-items-center gap-2" style="min-width:0">
                      <span class="badge-cat" style={`background:${art.color};flex-shrink:0`}>{art.cat}</span>
                      <span style="color:var(--parch-50);font-family:var(--font-heading);font-weight:600;font-size:16px">{art.title}</span>
                    </span>
                    <span class="text-muted-ka" style="font-size:13px;white-space:nowrap">{art.date} · {art.readingTime}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        )}
      </div>

      <!-- الفلاتر (يسار) -->
      <div class="col-lg-4">
        <div class="p-4" style="background:var(--night-700);border:1px solid var(--border-subtle);border-radius:var(--radius-md);position:sticky;top:96px">
          <div class="footer-head mb-3">فلترة حسب الباب</div>
          <div class="d-flex flex-column gap-2">
            {filters.map((f) => (
              <a href={f.h} class="d-flex align-items-center gap-2 p-2 rounded-3" style={`text-decoration:none;${f.active ? 'background:var(--night-600)' : ''}`}>
                {f.color && <span style={`width:9px;height:9px;border-radius:50%;background:${f.color}`}></span>}
                <span style={`font-family:var(--font-heading);font-weight:600;font-size:15px;color:${f.active ? 'var(--lantern-500)' : 'var(--text-secondary)'}`}>{f.t}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
