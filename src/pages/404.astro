---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Ornament from '../components/Ornament.astro';
import { getPublishedArticles } from '../lib/articles';

const suggestions = (await getPublishedArticles()).slice(0, 3);

const stars: [number, number, number, number][] = [
  [120,90,2,.7],[240,60,1.3,.5],[360,140,1.8,.6],[520,80,1.3,.5],[700,120,2,.6],[880,70,1.3,.4],
  [1040,140,1.8,.5],[1180,90,1.3,.5],[1320,150,1.8,.5],[80,220,1.5,.5],[420,240,1.3,.4],[760,260,1.6,.5],
  [1120,240,1.3,.4],[300,340,1.5,.5],[980,330,1.5,.5],[600,360,1.3,.4],[1260,300,1.5,.4],[180,400,1.3,.4],
];
---
<Base title="404 — خزعبلة ما لها وجود | خزعبلات" description="الصفحة غير موجودة — خزعبلة ما لها وجود! ارجع للرئيسية وتصفّح خزعبلاتنا.">
  <Header />

  <section class="hero" style="min-height:72vh; display:grid; place-items:center; text-align:center;">
    <svg class="hero__sky" viewBox="0 0 1440 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {stars.map(([x,y,r,o],i) => <circle class="twinkle" cx={x} cy={y} r={r} fill="#FDFBF6" opacity={o} style={`animation-delay:${(i%7)*0.4}s`}/>)}
    </svg>

    <div class="container-ka position-relative" style="z-index:1; padding-block:clamp(48px,8vw,90px);">
      <div class="lantern-wrap mb-3">
        <svg class="lantern" viewBox="0 0 180 250" style="width:130px" aria-hidden="true">
          <defs>
            <linearGradient id="g404" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#F4D08A"/><stop offset="0.55" stop-color="#E7B24B"/><stop offset="1" stop-color="#9A6C1E"/>
            </linearGradient>
            <radialGradient id="h404"><stop offset="0" stop-color="#E7B24B" stop-opacity="0.5"/><stop offset="0.55" stop-color="#E7B24B" stop-opacity="0.12"/><stop offset="1" stop-color="#E7B24B" stop-opacity="0"/></radialGradient>
            <radialGradient id="f404"><stop offset="0" stop-color="#FFF6E0"/><stop offset="0.5" stop-color="#F4D08A"/><stop offset="1" stop-color="#E7B24B" stop-opacity="0"/></radialGradient>
          </defs>
          <ellipse class="lantern-halo" cx="90" cy="150" rx="95" ry="100" fill="url(#h404)"/>
          <line x1="90" y1="4" x2="90" y2="48" stroke="#9A6C1E" stroke-width="2"/>
          <circle cx="90" cy="52" r="8" fill="none" stroke="#E7B24B" stroke-width="2.5"/>
          <path d="M70 62 L110 62 L118 80 L62 80 Z" fill="url(#g404)"/>
          <path d="M66 84 C50 122 50 162 66 194 L114 194 C130 162 130 122 114 84 Z" fill="url(#g404)" stroke="#9A6C1E" stroke-width="1.5"/>
          <ellipse cx="90" cy="140" rx="26" ry="42" fill="url(#f404)"/>
          <ellipse cx="90" cy="142" rx="8" ry="17" fill="#FFF6E0"/>
          <path d="M64 198 L116 198 L108 216 L72 216 Z" fill="url(#g404)"/>
          <circle cx="90" cy="222" r="4" fill="#E7B24B"/>
        </svg>
      </div>

      <div class="font-heading" style="font-family:var(--font-heading); font-weight:800; font-size:clamp(80px,15vw,150px); line-height:1; background:linear-gradient(180deg,var(--lantern-300),var(--lantern-600)); -webkit-background-clip:text; background-clip:text; color:transparent;">404</div>

      <h1 class="mt-3" style="font-size:clamp(26px,4vw,40px); color:var(--parch-50)">هذي الصفحة خزعبلة… ما لها وجود!</h1>
      <p class="text-secondary-ka mt-2" style="max-width:520px; margin-inline:auto; font-size:17px; line-height:1.8">
        يمكن ضاعت بين الحكايات، أو ما كانت من الأصل. رجّعناك للنور — اختر من هنا:
      </p>
      <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">
        <a href="/" class="btn btn-lantern rounded-3 px-4 py-3">رجّعني للرئيسية</a>
        <a href="/articles" class="btn btn-outline-ka rounded-3 px-4 py-3">تصفّح كل الخزعبلات</a>
      </div>
    </div>
  </section>

  {suggestions.length > 0 && (
    <section class="section container-ka" style="padding-top:0">
      <Ornament />
      <h2 class="text-start mt-4 mb-4" style="font-size:clamp(24px,4vw,32px)">خزعبلات قد تعجبك</h2>
      <div class="row g-4">
        {suggestions.map((a, i) => (
          <div class="col-12 col-md-6 col-lg-4" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
            <ArticleCard a={a} />
          </div>
        ))}
      </div>
    </section>
  )}

  <Footer />
</Base>
