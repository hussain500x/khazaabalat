---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Meter from '../../components/Meter.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import AdBanner from '../../components/AdBanner.astro';
import { getAllSlugs, getArticleBySlug } from '../../lib/articles';

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const a = await getArticleBySlug(slug as string);
if (!a) return Astro.redirect('/404');

// حكم المقياس بحسب المستوى
const VERDICT: Record<number, string> = { 1: 'صحيحة تماماً', 2: 'فيها شي من الصح', 3: 'مشكوك فيها', 4: 'خزعبلة', 5: 'خزعبلة كبرى' };
const VERDICT_TEXT: Record<number, string> = {
  1: 'بعد التحقّق: هذه المقولة صحيحة تماماً.',
  2: 'بعد التحقّق: فيها شيءٌ من الصحّة، مع تحفّظات.',
  3: 'بعد التحقّق: مشكوكٌ فيها ولا تقوم على دليلٍ واضح.',
  4: 'بعد التحقّق: هذه خزعبلة لا سند لها.',
  5: 'بعد التحقّق: خزعبلة كبرى بلا أي أساس.',
};
const verdict = VERDICT[a.level] ?? '';
const verdictText = VERDICT_TEXT[a.level] ?? '';

// تقسيم المتن على الأسطر الفارغة إلى فقرات، مع الحفاظ على فواصل الأسطر داخل الفقرة
const paragraphs = a.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// روابط المشاركة — تُبنى من الرابط الأساسي (canonical) وقت البناء
const shareUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const enc = encodeURIComponent;
const shareLinks = {
  whatsapp: `https://wa.me/?text=${enc(`${a.title} — ${shareUrl}`)}`,
  x: `https://twitter.com/intent/tweet?text=${enc(a.title)}&url=${enc(shareUrl)}`,
  telegram: `https://t.me/share/url?url=${enc(shareUrl)}&text=${enc(a.title)}`,
};
---
<Base title={`${a.title} | خزعبلات`} description={a.dek}>
  <Header />

  <section class="reading section" style="padding-block:44px">
    <div class="container-ka">
      <div class="reading-grid">
        <!-- شريط المشاركة (يمين) -->
        <aside class="sharebar">
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر واتساب"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4l.7 1.6c.1.1.1.3 0 .4l-.3.4-.3.3c-.1.1-.2.2-.1.4.1.2.5.9 1.1 1.4.8.7 1.4.9 1.6 1 .2.1.3.1.4-.1l.6-.7c.1-.2.3-.1.4-.1l1.5.7c.2.1.3.2.4.2.1.2.1.7-.1 1.3Z"/></svg></a>
          <a href={shareLinks.x} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر إكس"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 4 L20 20 M20 4 L4 20"/></svg></a>
          <a href={shareLinks.telegram} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر تلجرام"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 3 L2 11 L9 13 L11 20 L14 16 L18 19 Z"/></svg></a>
          <button type="button" class="share-ic" data-copy-link style="color:#fff;padding:0;cursor:pointer;font:inherit" aria-label="نسخ الرابط"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="9" y="9" width="11" height="12" rx="3"/><path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/></svg></button>
        </aside>

        <!-- عمود المتن (ورقي) -->
        <article class="reading-col prose" style={`--door:${a.color}`}>
          <nav class="breadcrumb-ka">
            <a href="/" style="color:inherit;text-decoration:none">الرئيسية</a>
            <span aria-hidden="true"> › </span>
            <a href={`/category/${a.catSlug}`} style="color:inherit;text-decoration:none">{a.cat}</a>
          </nav>

          <div class="d-flex align-items-center flex-wrap gap-3 mt-3">
            <span class="badge-cat" style={`background:${a.color}`}>{a.cat}</span>
            <Meter level={a.level} verdict={verdict} />
          </div>

          <h1 class="article-title mt-3">{a.title}</h1>
          {a.dek && <p class="dek-ink mt-2">{a.dek}</p>}

          <div class="d-flex align-items-center gap-3 mt-3">
            <span class="avatar-grad"></span>
            <div>
              <div class="byline-name">فريق خزعبلات</div>
              <div class="byline-meta">
                {a.date && <>آخر تحديث: {a.date}</>}
                {a.date && a.readingTime && <> · </>}
                {a.readingTime}
              </div>
            </div>
          </div>
          <div class="divider-ink"></div>

          {a.cover && (
            <figure class="m-0">
              <div class="hero-img-ink">
                <img src={a.cover} alt={a.title} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
              </div>
            </figure>
          )}

          {paragraphs.length > 0 ? (
            paragraphs.map((p) => (
              <p>{p.split('\n').map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}</p>
            ))
          ) : (
            <p class="caption-ink">لا يوجد نص لهذا المقال بعد.</p>
          )}

          <AdBanner adKey="57240eb3923c5094a71ce14b74947dec" width={300} height={250} />

          <div class="verdict-box mt-4">
            <div class="ttl">الحكم</div>
            <div class="my-3"><Meter level={a.level} verdict={verdict} /></div>
            <p class="sum">{verdictText}</p>
          </div>

          {a.tags.length > 0 && (
            <div class="d-flex flex-wrap gap-2 mt-4">
              {a.tags.map((t) => (
                <a class="tag-ink" href={`/tag/${encodeURIComponent(t)}`} style="text-decoration:none">#{t}</a>
              ))}
            </div>
          )}
        </article>

        <!-- العمود الجانبي (يسار): إعلان -->
        <aside class="leftrail">
          <div class="ad-sidebar">
            <AdBanner adKey="f104cd654f60f563baebd65cade734b0" width={160} height={600} />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <TelegramCTA />
  <Footer />

  <script>
    // زر نسخ رابط المقال
    const copyBtn = document.querySelector('[data-copy-link]') as HTMLElement | null;
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = location.href;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
        }
        copyBtn.style.color = 'var(--lantern-500)';
        copyBtn.setAttribute('aria-label', 'تم نسخ الرابط ✓');
        setTimeout(() => {
          copyBtn.style.color = '#fff';
          copyBtn.setAttribute('aria-label', 'نسخ الرابط');
        }, 1500);
      });
    }
  </script>
</Base>
