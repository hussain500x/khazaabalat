---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Meter from '../components/Meter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Ornament from '../components/Ornament.astro';
import TelegramCTA from '../components/TelegramCTA.astro';
import { articles } from '../data/site';

const toc = [
  { t: 'الخزعبلة', id: 'sec-1' },
  { t: 'من وين جت؟', id: 'sec-2' },
  { t: 'وش يقول العلم؟', id: 'sec-3' },
  { t: 'الحكم', id: 'sec-4' },
  { t: 'المصادر', id: 'sec-5' },
];
const timeline = [
  ['قديماً', 'الخوف من «العين» والحسد في الموروث الشعبي منذ قرون، مرتبطاً بالنظرة.'],
  ['القرن الماضي', 'ظهور الصيغة الحرفية «تكسر الحجر» في الأمثال المتداولة.'],
  ['اليوم', 'تنتشر على واتساب وإكس كطرفةٍ وتحذيرٍ في آنٍ واحد.'],
];
const sources = [
  'الموسوعة العربية — «الحسد والعين في الموروث الشعبي».',
  'معجم الأمثال الشعبية الخليجية — باب المبالغة البلاغية.',
];
const tags = ['#العين', '#موروث_شعبي', '#الخليج'];
// أشعة العين
const rays = Array.from({ length: 16 }, (_, i) => {
  const a = (i * Math.PI * 2) / 16, r1 = 40, r2 = i % 2 ? 64 : 54;
  return [130 + Math.cos(a) * r1, 75 + Math.sin(a) * r1, 130 + Math.cos(a) * r2, 75 + Math.sin(a) * r2];
});

// روابط المشاركة — تُبنى من الرابط الأساسي (canonical) وقت البناء
const shareTitle = 'هل صحيح أن العين تكسر الحجر؟';
const shareUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const enc = encodeURIComponent;
const shareLinks = {
  whatsapp: `https://wa.me/?text=${enc(`${shareTitle} — ${shareUrl}`)}`,
  x: `https://twitter.com/intent/tweet?text=${enc(shareTitle)}&url=${enc(shareUrl)}`,
  telegram: `https://t.me/share/url?url=${enc(shareUrl)}&text=${enc(shareTitle)}`,
};
---
<Base title="هل صحيح أن العين تكسر الحجر؟ | خزعبلات" description="هل صحيح أن العين تكسر الحجر؟ نتتبّع أصل المقولة في الموروث الشعبي ونفصل ما ثبت عمّا اختُلق، وننهيها بحكمٍ واضح على مقياس الخزعبلة." type="article">
  <Header />
  <div class="progress-bar"><span></span></div>

  <section class="reading section" style="padding-block:44px">
    <div class="container-ka">
      <div class="reading-grid">
        <!-- شريط المشاركة (يمين) -->
        <aside class="sharebar">
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر واتساب"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4l.7 1.6c.1.1.1.3 0 .4l-.3.4-.3.3c-.1.1-.2.2-.1.4.1.2.5.9 1.1 1.4.8.7 1.4.9 1.6 1 .2.1.3.1.4-.1l.6-.7c.1-.2.3-.1.4-.1l1.5.7c.2.1.3.2.4.2.1.2.1.7-.1 1.3Z"/></svg></a>
          <a href={shareLinks.x} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر إكس"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 4 L20 20 M20 4 L4 20"/></svg></a>
          <a href={shareLinks.telegram} target="_blank" rel="noopener noreferrer" class="share-ic" style="color:#fff" aria-label="مشاركة عبر تلجرام"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 3 L2 11 L9 13 L11 20 L14 16 L18 19 Z"/></svg></a>
          <button type="button" class="share-ic" data-copy-link style="color:#fff;padding:0;cursor:pointer;font:inherit" aria-label="نسخ الرابط"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="9" y="9" width="11" height="12" rx="3"/><path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/></svg></button>
        </aside>

        <!-- عمود المتن (ورقي) -->
        <article class="reading-col prose" style="--door:#3FB8A0">
          <nav class="breadcrumb-ka">الرئيسية › خرافات وتفنيد › العين تكسر الحجر</nav>
          <div class="d-flex align-items-center gap-3 mt-3">
            <span class="badge-cat-light">خرافات وتفنيد</span>
            <Meter level={4} verdict="خزعبلة" />
          </div>
          <h1 class="article-title mt-3">هل صحيح أن العين تكسر الحجر؟</h1>
          <p class="dek-ink mt-2">مقولة نسمعها من الصِّغَر بثقة كأنها آية… نتتبّع أصلها في الموروث الشعبي، ونفصل ما ثبت عمّا اختُلق — بأسلوب مبسّط وممتع.</p>
          <div class="d-flex align-items-center gap-3 mt-3">
            <span class="avatar-grad"></span>
            <div>
              <div class="byline-name">فريق خزعبلات</div>
              <div class="byline-meta">آخر تحديث: 12 أغسطس 2026 · 5 دقائق قراءة</div>
            </div>
          </div>
          <div class="divider-ink"></div>

          <figure class="m-0">
            <div class="hero-img-ink">
              <svg width="260" height="150" viewBox="0 0 260 150" aria-hidden="true">
                {rays.map(([x1,y1,x2,y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#E7B24B" stroke-opacity="0.4" stroke-width="1.2" stroke-linecap="round"/>)}
                <path d="M20 75 Q130 5 240 75 Q130 145 20 75 Z" fill="none" stroke="#E7B24B" stroke-width="2.4"/>
                <circle cx="130" cy="75" r="30" fill="none" stroke="#E7B24B" stroke-width="2.2"/>
                <circle cx="130" cy="75" r="20" fill="none" stroke="#F4D08A" stroke-width="1.4" opacity="0.7"/>
                <circle cx="130" cy="75" r="13" fill="#080A1C" stroke="#E7B24B" stroke-width="2"/>
                <circle cx="125" cy="70" r="4" fill="#FDFBF6" opacity="0.9"/>
              </svg>
            </div>
            <figcaption class="caption-ink">رسم توضيحي: خزعبلات</figcaption>
          </figure>

          <h2 id="sec-1"><span class="dia">◆</span> الخزعبلة — وش يقول الناس؟</h2>
          <p>تسمعها من جدّتك بثقة كأنها آية: «العين تكسر الحجر». يُقال إنّ نظرة الحسود قد تشقّ الصخر، وتُسقط الثمر من الشجر، وتُصيب القويّ في مقتله. ومع كل موقفٍ غريب، تُستدعى المقولة كتفسيرٍ جاهز لا يُناقَش.</p>
          <p>انتشرت الصيغة حتى صارت تُقال للمزاح أحياناً وللتخويف أحياناً أخرى — لكنها في الحالتين تُروى بوصفها حقيقةً مسلّماً بها. فهل لها أصلٌ فعلاً؟</p>

          <div class="compare">
            <div class="box say">
              <div class="lbl">يقولون…</div>
              <p class="txt">نظرة الحسود تشقّ الحجر وتُسقط الثمر، وتُصيب القويّ في مقتله بلا سبب ظاهر.</p>
            </div>
            <div class="box truth">
              <div class="lbl">الحقيقة…</div>
              <p class="txt">لا دليل على ضررٍ مادّي للنظر على الأجسام الصلبة؛ المقولة تعبير مجازي عن شدّة أثر الحسد.</p>
            </div>
          </div>

          <div class="ad-ink" style="min-height:250px"><div><div class="caption-ink" style="margin:0 0 6px">إعلان</div>مساحة إعلانية · 336×280</div></div>

          <h2 id="sec-2" class="mt-4"><span class="dia">◆</span> من وين جت؟</h2>
          <p>الحسد فكرة قديمة في ثقافات كثيرة، والخوف من «العين» موجود في الموروث العربي والخليجي منذ قرون. لكن الصيغة الحرفية «تكسر الحجر» أحدث بكثير من الفكرة نفسها.</p>
          <div class="timeline">
            {timeline.map(([yr, ds]) => (
              <div class="pt"><div class="yr">{yr}</div><div class="ds">{ds}</div></div>
            ))}
          </div>
          <div class="pullquote">
            <span class="mark">«</span>
            <p class="q">كثيرٌ من أمثالنا صادقةٌ في مقصدها، مبالِغةٌ في صياغتها — والفرق بينهما هو كل شيء.</p>
          </div>

          <h2 id="sec-3"><span class="dia">◆</span> وش يقول العلم؟</h2>
          <p>من ناحية فيزيائية، لا توجد آلية معروفة تجعل النظر يُحدث ضرراً مادّياً مباشراً في الأجسام الصلبة كالحجر. العين تستقبل الضوء ولا تُطلق طاقةً قادرةً على كسر شيء.</p>
          <p>أمّا أثر الحسد على الإنسان نفسياً فمسألة مختلفة: القلق من كونك «محسوداً» قد يسبّب توتراً حقيقياً — وهذا أثرٌ نفسي، لا فِعلٌ مباشر من العين في المادّة.</p>
          <p>تاريخياً، الأرجح أنّ العبارة وُلدت مبالغةً بلاغيةً لتصوير شدّة الحسد، ثم تحوّلت مع التكرار إلى ما يشبه الحقيقة الحرفية في التداول اليومي.</p>

          <div class="ad-ink" style="min-height:250px"><div><div class="caption-ink" style="margin:0 0 6px">إعلان</div>مساحة إعلانية</div></div>

          <h2 id="sec-4" class="mt-4"><span class="dia">◆</span> الحكم</h2>
          <div class="verdict-box">
            <div class="ttl">الحكم</div>
            <div class="my-3"><Meter level={4} verdict="خزعبلة" /></div>
            <p class="sum">للفكرة أصلٌ في الموروث كتعبيرٍ عن شدّة الحسد، لكن الصيغة المتداولة «تكسر الحجر» مبالغةٌ بلاغية لا سند لها مادّياً — استعمِلها للمزاح، لا كحقيقة.</p>
          </div>

          <h2 id="sec-5" class="mt-4"><span class="dia">◆</span> المصادر</h2>
          {sources.map((s) => <p class="source-cite" style="margin-bottom:10px;font-size:15px">{s}</p>)}

          <div class="d-flex flex-wrap gap-2 mt-4">
            {tags.map((t) => <span class="tag-ink">{t}</span>)}
          </div>
        </article>

        <!-- العمود الجانبي (يسار): فهرس + إعلان -->
        <aside class="leftrail">
          <div class="toc">
            <div class="footer-head mb-2">في هذا المقال</div>
            {toc.map((item, i) => <a href={`#${item.id}`} class={i === 0 ? 'active' : ''}>{item.t}</a>)}
          </div>
          <div class="ad-sidebar mt-4">
            <div class="ad-label text-start mb-2">إعلان</div>
            <div class="ad-ink" style="height:600px">مساحة إعلانية<br />300×600</div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- تلجرام + إعلان + اقرأ أيضاً -->
  <TelegramCTA />
  <section class="container-ka" style="padding-bottom:clamp(48px,7vw,88px)">
    <div class="ad-ink mx-auto" style="max-width:336px;height:280px" data-reveal>مساحة إعلانية · 336×280</div>
  </section>
  <section class="section container-ka" style="padding-top:0">
    <Ornament />
    <h2 class="text-start mt-4 mb-4" style="font-size:clamp(28px,4vw,36px)">اقرأ أيضاً</h2>
    <div class="row g-4">
      {articles.map((a, i) => (
        <div class="col-12 col-md-6 col-lg-4" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
          <ArticleCard a={a} />
        </div>
      ))}
    </div>
  </section>
  <Footer />

  <script>
    // زر نسخ رابط المقال
    const copyBtn = document.querySelector('[data-copy-link]') as HTMLElement | null;
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = location.href;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
        }
        copyBtn.style.color = 'var(--lantern-500)';
        copyBtn.setAttribute('aria-label', 'تم نسخ الرابط ✓');
        setTimeout(() => {
          copyBtn.style.color = '#fff';
          copyBtn.setAttribute('aria-label', 'نسخ الرابط');
        }, 1500);
      });
    }
  </script>
</Base>
