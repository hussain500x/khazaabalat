---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CAT } from '../../data/site';

const S = { published: ['منشور', '#35A96A'], draft: ['مسودة', '#7E7A6E'], scheduled: ['مجدول', '#4A8FE7'] };
const rows = [
  ['هل صحيح أن العين تكسر الحجر؟', 'خرافات وتفنيد', CAT.myths.color, 'published', '12 أغسطس 2026'],
  ['أم الدويس: أشهر قصة مخيفة في الخليج', 'أساطير وحكايات', CAT.legends.color, 'published', '11 أغسطس 2026'],
  ['لماذا يخاف اليابانيون من الرقم 4؟', 'غرائب العالم', CAT.world.color, 'scheduled', '14 أغسطس 2026'],
  ['نصائح الواتساب الطبية: دليل ساخر', 'هزل وسخرية', CAT.satire.color, 'draft', '—'],
  ['لماذا نقول «امسك الخشب»؟', 'خرافات وتفنيد', CAT.myths.color, 'published', '9 أغسطس 2026'],
  ['السعلوة: من الصحراء لمواقع التواصل', 'أساطير وحكايات', CAT.legends.color, 'draft', '—'],
];
const tabs = [['الكل', 'all', true], ['منشور', 'published', false], ['مسودة', 'draft', false], ['مجدول', 'scheduled', false]];
---
<AdminLayout title="إدارة المحتوى | خزعبلات" active="content" pageTitle="إدارة المحتوى" subtitle="أضِف، عدّل، واحذف مقالات الموقع">
  <!-- رأس -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div class="text-start">
      <div style="font-family:var(--font-heading);font-weight:700;font-size:22px;color:var(--parch-50)">كل المقالات</div>
      <div class="text-muted-ka" style="font-size:13px">124 مقالًا · 8 مسودات</div>
    </div>
    <a class="admin-newbtn" href="/admin/new" style="margin:0;padding:12px 18px">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--night-900)" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      إضافة محتوى
    </a>
  </div>

  <!-- تبويبات -->
  <div class="content-tabs d-flex flex-wrap gap-2 mb-4">
    {tabs.map(([t, f, a]) => <button class={a ? 'pill-tab active' : 'pill-tab'} data-filter={f}>{t}</button>)}
  </div>

  <!-- القائمة (RTL: العنوان يمين، الأزرار يسار) -->
  <div class="arc-list d-flex flex-column gap-2">
    {rows.map(([title, cat, color, st, date]) => (
      <div class="arc-item" data-status={st}>
        <span class="title flex-grow-1 text-start">{title}</span>
        <span class="badge-cat" style={`background:${color};flex-shrink:0`}>{cat}</span>
        <span class="text-muted-ka" style="font-size:13px;white-space:nowrap;width:120px;text-align:center">{date}</span>
        <span class="status" style={`background:color-mix(in srgb,${S[st][1]} 16%, transparent);color:${S[st][1]}`}>{S[st][0]}</span>
        <div class="d-flex gap-2">
          <a class="ic-sm" href="/admin/new" aria-label="تعديل"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.7" stroke-linejoin="round"><path d="M4 20l4-1L19 8l-3-3L5 16l-1 4Z"/></svg></a>
          <button class="ic-sm" data-del aria-label="حذف"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#DC4C4C" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg></button>
        </div>
      </div>
    ))}
  </div>

  <script>
    const tabs = document.querySelectorAll('.content-tabs .pill-tab');
    const items = document.querySelectorAll('.arc-list .arc-item');
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.classList.remove('active'));
        t.classList.add('active');
        const f = t.getAttribute('data-filter');
        items.forEach((it) => {
          (it as HTMLElement).style.display = f === 'all' || it.getAttribute('data-status') === f ? '' : 'none';
        });
      })
    );
    document.querySelectorAll('[data-del]').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (confirm('حذف هذا المقال؟')) btn.closest('.arc-item')?.remove();
      })
    );
  </script>
</AdminLayout>
