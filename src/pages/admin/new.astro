---
import AdminLayout from '../../layouts/AdminLayout.astro';

const doors = [
  ['المجهر', '#3FB8A0', 'myths'],
  ['الحكاية', '#7B5CD6', 'legends'],
  ['الضحكة', '#E2603F', 'satire'],
  ['الرحلة', '#E7B24B', 'world'],
];
---
<AdminLayout title="مقال جديد | خزعبلات" active="content" pageTitle="مقال جديد" subtitle="املأ الحقول ثم احفظ أو انشر">
  <button slot="actions" id="save-draft" class="btn rounded-3 px-4 py-2" style="border:1px solid var(--border-strong);color:var(--text-secondary);font-family:var(--font-heading);font-weight:600;background:transparent">حفظ كمسودة</button>
  <button slot="actions" id="publish" class="btn btn-lantern rounded-3 px-4 py-2">نشر</button>

  <div id="editor-msg" style="display:none;margin-bottom:16px;padding:12px 16px;border-radius:10px;font-size:14px;font-family:var(--font-heading);font-weight:600"></div>

  <div class="row g-4">
    <!-- العمود الرئيسي (يمين) -->
    <div class="col-lg-8">
      <div class="field mb-3">
        <label>عنوان المقال</label>
        <input id="f-title" class="f-input" style="font-family:var(--font-heading);font-weight:700;font-size:20px" placeholder="اكتب عنوان المقال…" />
      </div>
      <div class="field mb-3">
        <label>الرابط (Slug)</label>
        <div class="d-flex align-items-center gap-2 f-input" style="justify-content:space-between">
          <span id="f-slug" style="color:var(--parch-50)">—</span>
          <span class="text-muted-ka" style="font-size:13px;direction:ltr">/article/</span>
        </div>
      </div>
      <div class="field mb-3">
        <label>السطر التشويقي</label>
        <textarea id="f-dek" class="f-input" rows="2" style="resize:vertical" placeholder="جملة تشويقية قصيرة تظهر في البطاقة…"></textarea>
      </div>
      <div class="field">
        <label>المتن</label>
        <textarea id="f-body" class="f-input" rows="14" style="resize:vertical;line-height:1.9;font-size:15px" placeholder="اكتب المقال هنا… اترك سطرًا فارغًا لبدء فقرة جديدة."></textarea>
      </div>
    </div>

    <!-- العمود الجانبي (يسار) -->
    <div class="col-lg-4">
      <div class="card-box mb-3">
        <h3>الباب</h3>
        <div class="door-group d-flex flex-wrap gap-2 mb-3" style="justify-content:flex-start">
          {doors.map(([t, c, slug], i) => (
            <button class={i === 0 ? 'chip active' : 'chip'} style={`--c:${c}`} data-cat={slug}>
              {t}<span style={`width:8px;height:8px;border-radius:50%;background:${c}`}></span>
            </button>
          ))}
        </div>
        <label style="display:block;text-align:start;font-family:var(--font-heading);font-weight:600;font-size:13px;color:var(--text-secondary);margin-bottom:8px">مقياس الخزعبلة <span class="text-muted-ka" style="font-weight:400">(انقر لتغيير المستوى)</span></label>
        <div class="meter ka-meter" data-level="4" style="justify-content:flex-start">
          <span class="meter__verdict ka-verdict" style="font-size:16px">خزعبلة</span>
          <span class="meter__lamps">
            {[1, 2, 3, 4, 5].map((v) => <button class="lamp" data-v={v} aria-label={`مستوى ${v}`}></button>)}
          </span>
        </div>
      </div>

      <div class="card-box mb-3">
        <h3>صورة الغلاف (رابط)</h3>
        <input id="f-cover" class="f-input" style="direction:ltr;font-size:13px" placeholder="https://…/image.webp" />
        <div class="text-muted-ka" style="font-size:11px;margin-top:6px">الصق رابط صورة (الرفع المباشر لاحقًا).</div>
      </div>

      <div class="card-box">
        <h3>الوسوم</h3>
        <input id="f-tags" class="f-input" style="font-size:14px" placeholder="العين، موروث شعبي، الخليج" />
        <div class="text-muted-ka" style="font-size:11px;margin-top:6px">افصل بينها بفاصلة.</div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    const sb = supabase();

    const titleEl = document.getElementById('f-title') as HTMLInputElement;
    const slugEl = document.getElementById('f-slug') as HTMLElement;
    const dekEl = document.getElementById('f-dek') as HTMLTextAreaElement;
    const bodyEl = document.getElementById('f-body') as HTMLTextAreaElement;
    const coverEl = document.getElementById('f-cover') as HTMLInputElement;
    const tagsEl = document.getElementById('f-tags') as HTMLInputElement;
    const msg = document.getElementById('editor-msg') as HTMLElement;

    // مقياس الخزعبلة
    const V: Record<number, [string, string]> = { 1: ['صحيحة تماماً', '#35A96A'], 2: ['فيها شي من الصح', '#3FB8A0'], 3: ['مشكوك فيها', '#E0A22C'], 4: ['خزعبلة', '#E2603F'], 5: ['خزعبلة كبرى', '#DC4C4C'] };
    const meter = document.querySelector('.ka-meter') as HTMLElement;
    const lamps = Array.from(meter.querySelectorAll('.lamp')) as HTMLElement[];
    const verdictEl = meter.querySelector('.ka-verdict') as HTMLElement;
    const setLevel = (lvl: number) => {
      meter.dataset.level = String(lvl);
      meter.style.setProperty('--meter-c', V[lvl][1]);
      lamps.forEach((l) => l.classList.toggle('lit', Number(l.dataset.v) <= lvl));
      verdictEl.textContent = V[lvl][0];
      verdictEl.style.color = V[lvl][1];
    };
    lamps.forEach((l) => l.addEventListener('click', () => setLevel(Number(l.dataset.v))));
    setLevel(4);

    // اختيار مجموعة واحدة نشطة
    const single = (sel: string) => {
      const items = document.querySelectorAll(sel);
      items.forEach((i) => i.addEventListener('click', () => { items.forEach((x) => x.classList.remove('active')); i.classList.add('active'); }));
    };
    single('.door-group [data-cat]');

    // توليد الرابط من العنوان (يدعم العربية)
    const slugify = (s: string) => s.trim().toLowerCase()
      .replace(/[^\p{L}\p{N}\s-]/gu, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .slice(0, 80) || ('article-' + Date.now());
    let slug = '';
    titleEl.addEventListener('input', () => { slug = slugify(titleEl.value); slugEl.textContent = slug || '—'; });

    // وضع التعديل (?id=)
    const editId = new URLSearchParams(location.search).get('id');
    if (editId) {
      document.title = 'تعديل مقال | خزعبلات';
      sb.from('articles').select('*').eq('id', editId).single().then(({ data }) => {
        if (!data) return;
        titleEl.value = data.title; slug = data.slug; slugEl.textContent = data.slug;
        dekEl.value = data.dek || ''; bodyEl.value = data.body || '';
        coverEl.value = data.cover_url || ''; tagsEl.value = (data.tags || []).join('، ');
        setLevel(data.level || 4);
        document.querySelectorAll('.door-group [data-cat]').forEach((c) =>
          c.classList.toggle('active', c.getAttribute('data-cat') === data.category)
        );
      });
    }

    const showMsg = (text: string, ok: boolean) => {
      msg.textContent = text;
      msg.style.display = 'block';
      msg.style.background = ok ? 'color-mix(in srgb, var(--teal-500) 16%, transparent)' : 'color-mix(in srgb, #DC4C4C 16%, transparent)';
      msg.style.color = ok ? 'var(--teal-500)' : '#DC4C4C';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const save = async (status: string) => {
      const title = titleEl.value.trim();
      if (!title) { showMsg('اكتب عنوان المقال أولًا.', false); return; }
      if (!slug) slug = slugify(title);
      const body = bodyEl.value.trim();
      const mins = Math.max(1, Math.round((body ? body.split(/\s+/).length : 0) / 200));
      const tags = tagsEl.value.split(/[،,]/).map((t) => t.trim()).filter(Boolean);
      const category = document.querySelector('.door-group [data-cat].active')?.getAttribute('data-cat') || 'myths';

      const { data: { user } } = await sb.auth.getUser();
      const row = {
        title, slug, dek: dekEl.value.trim(), body,
        category, level: Number(meter.dataset.level) || 4, status,
        cover_url: coverEl.value.trim() || null,
        reading_time: `${mins} دقائق قراءة`,
        tags,
        author_id: user?.id ?? null,
        published_at: status === 'published' ? new Date().toISOString() : null,
      };

      const { error } = editId
        ? await sb.from('articles').update(row).eq('id', editId)
        : await sb.from('articles').insert(row);

      if (error) { showMsg('تعذّر الحفظ: ' + error.message, false); return; }
      showMsg(status === 'published' ? 'نُشر المقال بنجاح ✓' : 'حُفظ كمسودة ✓', true);
      setTimeout(() => location.assign('/admin'), 900);
    };

    document.getElementById('publish')?.addEventListener('click', () => save('published'));
    document.getElementById('save-draft')?.addEventListener('click', () => save('draft'));
  </script>
</AdminLayout>
