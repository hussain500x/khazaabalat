---
import 'bootstrap/dist/css/bootstrap.rtl.min.css';
import '../styles/theme.css';
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, image = '/og-default.png', type = 'website' } = Astro.props;

// إعدادات الموقع (وقت البناء) — عنوان/وصف افتراضيان + AdSense + تحليلات.
const settings = await getSettings();
const pageTitle = title || settings.seo_title || 'خزعبلات — كل خزعبلة لها قصة';
const pageDesc =
  description ||
  settings.seo_description ||
  'خزعبلات — نفحص الخرافات والأساطير والطرائف الشعبية تحت الضوء ونقول لك الحقيقة بمقياس الخزعبلة، وأنت تضحك في الطريق.';
const adsenseOn = settings.adsense_enabled && settings.adsense_client.startsWith('ca-pub-');
const analyticsId = settings.analytics_id.trim();

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---
<!doctype html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="خزعبلات" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="خزعبلات" href="/feed.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Rakkas&family=Readex+Pro:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y1rdjy8hqd");
    </script>

    <!-- Google AdSense (من الإعدادات) -->
    {adsenseOn && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${settings.adsense_client}`} crossorigin="anonymous"></script>
    )}

    <!-- Google Analytics (من الإعدادات) -->
    {analyticsId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
    )}
    {analyticsId && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analyticsId}');`}></script>
    )}
  </head>
  <body>
    <slot />
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <script>
      // رابط تلجرام لحظي: نقرأ آخر قيمة من القاعدة ونحدّث كل [data-tg-link] بلا إعادة نشر.
      import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/public-env';
      fetch(`${SUPABASE_URL}/rest/v1/site_settings?id=eq.1&select=telegram_url`, { headers: { apikey: SUPABASE_ANON_KEY } })
        .then((r) => (r.ok ? r.json() : []))
        .then((rows) => {
          const url = Array.isArray(rows) && rows[0] && rows[0].telegram_url;
          if (url) document.querySelectorAll('[data-tg-link]').forEach((a) => a.setAttribute('href', url));
        })
        .catch(() => {});
    </script>
  </body>
</html>
