---
import 'bootstrap/dist/css/bootstrap.rtl.min.css';
import '../styles/theme.css';
import '../styles/admin.css';

interface Props { title: string; active: string; pageTitle: string; subtitle?: string; }
const { title, active, pageTitle, subtitle } = Astro.props;

const nav = [
  { t: 'المحتوى', h: '/admin', key: 'content', icon: '<path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v6h6" /><path d="M8 13h8M8 17h5" stroke-linecap="round"/>' },
  { t: 'الإعدادات', h: '/admin/settings', key: 'settings', icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>' },
];
const hasActions = Astro.slots.has('actions');
---
<!doctype html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Rakkas&family=Readex+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="admin" id="admin-root" style="visibility:hidden">
      <!-- الشريط الجانبي -->
      <aside class="admin-side">
        <a class="admin-logo" href="/" style="text-decoration:none">
          <span class="w">خزعبلات</span>
          <span class="brand-mark" style="width:34px;height:34px;font-size:16px">؟</span>
        </a>
        <a class="admin-newbtn" href="/admin/new">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--night-900)" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          إضافة محتوى
        </a>
        <nav class="admin-nav">
          {nav.map((n) => (
            <a href={n.h} class={active === n.key ? 'active' : ''}>
              {n.t}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.8" set:html={n.icon}></svg>
            </a>
          ))}
        </nav>
        <div class="admin-spacer"></div>
        <div class="admin-user">
          <div class="flex-grow-1" style="text-align:start;min-width:0">
            <div id="user-name" style="font-family:var(--font-heading);font-weight:600;font-size:14px;color:var(--parch-50);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">…</div>
            <button id="logout-btn" type="button" style="background:none;border:none;padding:0;font-size:12px;color:var(--text-muted);cursor:pointer;font-family:var(--font-body)">تسجيل الخروج</button>
          </div>
          <span class="av"></span>
        </div>
      </aside>

      <!-- الرئيسية -->
      <main class="admin-main">
        <div class="admin-topbar">
          <div>
            <h1 class="t">{pageTitle}</h1>
            {subtitle && <div class="s">{subtitle}</div>}
          </div>
          <div class="d-flex align-items-center gap-3">
            {hasActions ? (
              <slot name="actions" />
            ) : (
              <>
                <div class="admin-search d-none d-md-flex">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4" stroke-linecap="round"/></svg>
                  بحث…
                </div>
                <span class="icon-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" stroke-linecap="round"><path d="M6 16c0-6 2-8 6-8s6 2 6 8"/><path d="M4 16h16"/><path d="M10 19a2 2 0 0 0 4 0"/></svg></span>
              </>
            )}
          </div>
        </div>
        <div class="admin-content">
          <slot />
        </div>
      </main>
    </div>
    <script>
      import { supabase } from '../lib/supabase';
      const sb = supabase();
      const root = document.getElementById('admin-root');
      // حارس الجلسة: لو ما فيه تسجيل دخول، حوّل لصفحة الدخول
      sb.auth.getSession().then(({ data }) => {
        if (!data.session) { location.replace('/admin/login'); return; }
        const nameEl = document.getElementById('user-name');
        if (nameEl) nameEl.textContent = data.session.user.email ?? 'مستخدم';
        if (root) root.style.visibility = 'visible';
      });
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        const { error } = await sb.auth.signOut();
        if (error) { alert('تعذّر تسجيل الخروج: ' + error.message); return; }
        location.replace('/admin/login');
      });
    </script>
  </body>
</html>
