# خزعبلات — متغيّرات البيئة
# انسخ هذا الملف إلى ".env" واملأ القيم من Supabase → Settings → API.
# ملف .env مستثنى من Git ولا يُرفع أبدًا. لا تلصق هذه القيم في الشات.

# عام — يُكشف للمتصفّح (آمن؛ محمي بسياسات RLS)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# 🔒 سري — للسيرفر فقط. لا يبدأ بـPUBLIC_ فلا يصل المتصفّح إطلاقًا.
SUPABASE_SERVICE_ROLE_KEY=
